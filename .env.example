# ════════════════════════════════════════════════════════════════════════════
# Frontend Astro (serveur Node standalone)
# Local  : copier en .env et garder les valeurs localhost
# Prod   : /var/www/wwa/.env sur le VPS (chown www-data, chmod 600)
# ════════════════════════════════════════════════════════════════════════════

# ── Identite de l'environnement ────────────────────────────────────────────
# Laisser VIDE en local. En prod : production. En test : staging.
# deploy.sh refuse de deployer si la valeur ne correspond pas a la cible.
PUBLIC_ENV_NAME=

# ── Hotes publics ──────────────────────────────────────────────────────────
# Vitrine
PUBLIC_SITE_URL=http://localhost:4321
# Back-office (login / register / dashboard / admin).
# Laisser VIDE en local : les deux hôtes se confondent, pas de redirection.
# En prod : PUBLIC_APP_URL=https://app.worldwise-admission.com
PUBLIC_APP_URL=

# Domaine du cookie de session, à définir en prod SEULEMENT.
# Le point initial est obligatoire pour partager la session entre
# domaine.com (page /candidature) et app.domaine.com (dashboard).
# En prod : COOKIE_DOMAIN=.worldwise-admission.com
COOKIE_DOMAIN=

# ── Serveur Node (lu par dist/server/entry.mjs en prod) ─────────────────────
HOST=127.0.0.1
PORT=4321

# ── Auth ────────────────────────────────────────────────────────────────────
# Générer en prod : openssl rand -base64 48
JWT_SECRET=change-me-in-production

# Compte Super Admin (doit correspondre à api/.env)
SUPER_ADMIN_EMAIL=info@worldwise-admission.com
SUPER_ADMIN_PASSWORD=your-secure-password-here

# ── Backend Laravel ─────────────────────────────────────────────────────────
# Appels serveur-à-serveur (jamais exposé au navigateur)
BACKEND_URL=http://localhost:8000
PUBLIC_BACKEND_URL=http://localhost:8000

# ── Reverb (WebSocket temps réel, valeurs lues par le navigateur) ───────────
# PUBLIC_REVERB_APP_KEY doit être identique à REVERB_APP_KEY dans api/.env
PUBLIC_REVERB_APP_KEY=your-app-key
PUBLIC_REVERB_HOST=localhost
PUBLIC_REVERB_PORT=8080
PUBLIC_REVERB_SCHEME=http
# En prod (Reverb derrière nginx TLS sur api.domaine.com/app) :
#   PUBLIC_REVERB_HOST=api.worldwise-admission.com
#   PUBLIC_REVERB_PORT=443
#   PUBLIC_REVERB_SCHEME=https

# ── Google OAuth (à configurer dans Google Cloud Console) ───────────────────
# PUBLIC_GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
