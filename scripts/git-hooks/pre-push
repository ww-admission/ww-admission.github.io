#!/bin/sh
# ============================================================================
# pre-push — empeche de pousser sur PROD par accident
#
# Active via :  git config core.hooksPath scripts/git-hooks
#               (fait par scripts/install-git-hooks.ps1)
#
# Seul scripts/promote.ps1 met WWA_PROMOTE=1, donc seul lui peut pousser sur
# PROD. Un `git push origin PROD` tape a la main est refuse.
#
# Contournement d'urgence (a n'utiliser qu'en connaissance de cause) :
#   WWA_PROMOTE=1 git push origin PROD        (bash)
#   $env:WWA_PROMOTE=1; git push origin PROD  (PowerShell)
# ============================================================================

PROTECTED_BRANCH="PROD"
RED=$(printf '\033[1;31m'); YEL=$(printf '\033[1;33m'); OFF=$(printf '\033[0m')

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    "refs/heads/$PROTECTED_BRANCH")
      if [ "$WWA_PROMOTE" = "1" ]; then
        printf '%s  Promotion vers %s autorisee (via promote).%s\n' "$YEL" "$PROTECTED_BRANCH" "$OFF" >&2
      else
        printf '\n%s==================================================================%s\n' "$RED" "$OFF" >&2
        printf '%s  PUSH REFUSE : %s est la branche de PRODUCTION%s\n' "$RED" "$PROTECTED_BRANCH" "$OFF" >&2
        printf '%s==================================================================%s\n' "$RED" "$OFF" >&2
        printf '\n' >&2
        printf '  Pousser sur %s met a jour le site LIVE vu par les candidats.\n' "$PROTECTED_BRANCH" >&2
        printf '  On ne pousse jamais dessus a la main.\n\n' >&2
        printf '  Le bon chemin :\n' >&2
        printf '    1. travailler et pousser sur  develop\n' >&2
        printf '    2. verifier sur  https://dev.worldwise-admission.com\n' >&2
        printf '    3. puis, seulement ensuite :  npm run promote\n\n' >&2
        exit 1
      fi
      ;;
    "refs/heads/main")
      printf '\n%s  Attention : la branche `main` n est plus utilisee.%s\n' "$YEL" "$OFF" >&2
      printf '  Les branches actives sont  develop  (test) et  PROD  (production).\n\n' >&2
      ;;
  esac
done

exit 0
