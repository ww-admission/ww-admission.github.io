#!/bin/sh
# ============================================================================
# pre-push — garde-fous locaux autour de la production
#
# Active via :  git config core.hooksPath scripts/git-hooks
#               (fait par scripts/install-git-hooks.ps1)
#
# Refuse :
#   - tout push direct sur `main` : main est avance automatiquement par le
#     workflow PRODUCTION sur la version en ligne, jamais a la main ;
#   - la suppression ou le deplacement d'un tag de version vX.Y.Z : chaque tag
#     est l'archive d'une version passee en production.
#
# Contournement d'urgence (a n'utiliser qu'en connaissance de cause) :
#   WWA_FORCE_PUSH=1 git push ...        (bash)
#   $env:WWA_FORCE_PUSH=1; git push ...  (PowerShell)
# ============================================================================

ZERO="0000000000000000000000000000000000000000"
RED=$(printf '\033[1;31m'); YEL=$(printf '\033[1;33m'); OFF=$(printf '\033[0m')

refuse() {
  printf '\n%s==================================================================%s\n' "$RED" "$OFF" >&2
  printf '%s  PUSH REFUSE%s\n' "$RED" "$OFF" >&2
  printf '%s==================================================================%s\n' "$RED" "$OFF" >&2
  printf '\n  %s\n\n' "$1" >&2
  printf '  Le bon chemin :\n' >&2
  printf '    TEST        : pousser sur develop\n' >&2
  printf '    PRODUCTION  : npm run release           (nouvelle version depuis develop)\n' >&2
  printf '                  npm run release:hotfix    (correctif depuis une branche hotfix/*)\n\n' >&2
  exit 1
}

while read -r _local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      [ "$WWA_FORCE_PUSH" = "1" ] && { printf '%s  WWA_FORCE_PUSH=1 : push sur main sans controle.%s\n' "$YEL" "$OFF" >&2; continue; }
      refuse "main est mis a jour par le workflow PRODUCTION, pas a la main."
      ;;
    refs/tags/v*)
      [ "$WWA_FORCE_PUSH" = "1" ] && { printf '%s  WWA_FORCE_PUSH=1 : tag %s modifie sans controle.%s\n' "$YEL" "${remote_ref#refs/tags/}" "$OFF" >&2; continue; }
      [ "$local_sha" = "$ZERO" ] && refuse "Suppression du tag ${remote_ref#refs/tags/} interdite : c'est l'archive d'une version."
      [ "$remote_sha" != "$ZERO" ] && refuse "Le tag ${remote_ref#refs/tags/} existe deja sur GitHub : une version publiee ne se deplace pas. Cree la version suivante."
      ;;
  esac
done

exit 0
