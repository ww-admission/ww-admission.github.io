# ════════════════════════════════════════════════════════════════════════════
# /var/www/wwa-dev/api/.env  —  Laravel, environnement de TEST (VPS OVH)
#
#   sudo chown www-data:www-data /var/www/wwa-dev/api/.env
#   sudo chmod 600 /var/www/wwa-dev/api/.env
# ════════════════════════════════════════════════════════════════════════════

APP_NAME=WWA-API-DEV
APP_ENV=production
# Généré par : php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.dev.worldwise-admission.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Origine navigateur autorisée par CORS = le back-office
FRONTEND_URL=https://app.dev.worldwise-admission.com

# ── Compte Super Admin (créé par le seeder, aucun fallback) ────────────────
SUPER_ADMIN_EMAIL=info@worldwise-admission.com
SUPER_ADMIN_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT

# ── Base de données PostgreSQL (locale au VPS) ─────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wwa_staging
DB_USERNAME=wwa_dev_user
DB_PASSWORD=REMPLACER_PAR_LE_MOT_DE_PASSE_DB

# ── Sessions / cache / queue (tables PostgreSQL, pas de Redis en phase 1) ──
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

BCRYPT_ROUNDS=12

# ── Logs ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Stockage des pièces jointes (disque local, jamais exposé par nginx) ────
FILESYSTEM_DISK=local

# ── Broadcast temps réel (Reverb) ──────────────────────────────────────────
BROADCAST_CONNECTION=reverb

# Générer trois valeurs aléatoires distinctes (openssl rand -hex 16)
REVERB_APP_ID=REMPLACER
REVERB_APP_KEY=REMPLACER
REVERB_APP_SECRET=REMPLACER

# Hôte public annoncé aux clients (nginx proxifie /app vers 127.0.0.1:8080)
REVERB_HOST=api.dev.worldwise-admission.com
REVERB_PORT=443
REVERB_SCHEME=https

# Adresse d'écoute réelle du process Reverb
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8081

# JAMAIS '*' en production (Cross-Site WebSocket Hijacking)
REVERB_ALLOWED_ORIGINS=https://app.dev.worldwise-admission.com

REVERB_APP_RATE_LIMITING_ENABLED=true
REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=60
REVERB_APP_RATE_LIMIT_DECAY_SECONDS=60

# ── Emails : en test, on n'envoie RIEN a un vrai candidat ──────────────────
# MAIL_MAILER=log ecrit les emails dans storage/logs/ au lieu de les envoyer.
# Ne repasse a smtp que si tu testes volontairement l'envoi, avec tes adresses.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@dev.worldwise-admission.com
MAIL_FROM_NAME="WWA (TEST)"

# Bloc SMTP reel, laisse commente volontairement :
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=465
# MAIL_USERNAME=resend
# MAIL_PASSWORD=REMPLACER_PAR_LA_CLE_RESEND
# MAIL_SCHEME=smtps
