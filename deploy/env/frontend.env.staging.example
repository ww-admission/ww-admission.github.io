# ════════════════════════════════════════════════════════════════════════════
# /var/www/wwa-dev/.env  —  Frontend Astro, environnement de TEST
#
# Lu deux fois :
#   1. au BUILD  (npm run build) -> les PUBLIC_* sont figees dans le bundle
#   2. au RUNTIME (systemd EnvironmentFile) -> les variables serveur
#
# Format systemd strict : KEY=value, pas de `export`, pas de commentaire
# en fin de ligne, pas d'espace autour du `=`.
#
#   sudo chown www-data:www-data /var/www/wwa-dev/.env
#   sudo chmod 600 /var/www/wwa-dev/.env
# ════════════════════════════════════════════════════════════════════════════

# ── Identite de l'environnement ────────────────────────────────────────────
# deploy.sh refuse de deployer si cette valeur ne correspond pas a la cible.
# C'est aussi ce qui declenche le bandeau orange et le robots.txt Disallow.
PUBLIC_ENV_NAME=staging

# ── Hotes publics ──────────────────────────────────────────────────────────
# TOUT l'environnement de test vit sous `dev.`.
PUBLIC_SITE_URL=https://dev.worldwise-admission.com
PUBLIC_APP_URL=https://app.dev.worldwise-admission.com

# Doit valoir exactement l'hote de PUBLIC_SITE_URL, precede d'un point.
# C'est ce qui isole la session de test de celle de production.
# NE JAMAIS mettre .worldwise-admission.com ici : un login sur le test
# deconnecterait les utilisateurs du site live (meme nom de cookie).
COOKIE_DOMAIN=.dev.worldwise-admission.com

# ── Serveur Node ───────────────────────────────────────────────────────────
# Port 4322 : la production occupe le 4321.
HOST=127.0.0.1
PORT=4322
NODE_ENV=production

# ── Auth ───────────────────────────────────────────────────────────────────
# OBLIGATOIREMENT different de celui de la production (deploy.sh le verifie).
# openssl rand -base64 48
JWT_SECRET=REMPLACER_PAR_UNE_CLE_ALEATOIRE_DIFFERENTE_DE_LA_PROD

# ── Backend Laravel de test ────────────────────────────────────────────────
BACKEND_URL=https://api.dev.worldwise-admission.com

# ── Reverb de test ─────────────────────────────────────────────────────────
# PUBLIC_REVERB_APP_KEY doit etre IDENTIQUE a REVERB_APP_KEY de api/.env
PUBLIC_REVERB_APP_KEY=REMPLACER_PAR_LA_MEME_CLE_QUE_API_DEV
PUBLIC_REVERB_HOST=api.dev.worldwise-admission.com
PUBLIC_REVERB_PORT=443
PUBLIC_REVERB_SCHEME=https
