# ════════════════════════════════════════════════════════════════════════════
# /var/www/wwa/.env  —  Frontend Astro en production (VPS OVH)
#
# Lu deux fois :
#   1. au BUILD  (npm run build) → les PUBLIC_* sont figées dans le bundle
#   2. au RUNTIME (systemd EnvironmentFile) → les variables secrètes
#
# Format systemd strict : KEY=value, pas de `export`, pas de commentaire
# en fin de ligne, pas d'espace autour du `=`.
#
#   sudo chown www-data:www-data /var/www/wwa/.env
#   sudo chmod 600 /var/www/wwa/.env
# ════════════════════════════════════════════════════════════════════════════

# ── Identite de l'environnement (verifiee par deploy.sh) ───────────────────
PUBLIC_ENV_NAME=production

# ── Hotes publics (remplacer worldwise-admission.com par le domaine reel) ──
PUBLIC_SITE_URL=https://worldwise-admission.com
PUBLIC_APP_URL=https://app.worldwise-admission.com

# Le point initial est OBLIGATOIRE : la session doit être valable sur
# domaine.com (page /candidature) ET sur app.domaine.com (dashboard).
COOKIE_DOMAIN=.worldwise-admission.com

# ── Serveur Node (écoute en local, nginx fait le TLS devant) ───────────────
HOST=127.0.0.1
PORT=4321
NODE_ENV=production

# ── Auth ───────────────────────────────────────────────────────────────────
# openssl rand -base64 48
JWT_SECRET=REMPLACER_PAR_UNE_CLE_ALEATOIRE

# ── Backend Laravel (appels serveur-à-serveur, jamais exposé au navigateur) ─
BACKEND_URL=https://api.worldwise-admission.com

# ── Reverb (valeurs lues par le navigateur) ────────────────────────────────
# PUBLIC_REVERB_APP_KEY doit être IDENTIQUE à REVERB_APP_KEY de api/.env
PUBLIC_REVERB_APP_KEY=REMPLACER_PAR_LA_MEME_CLE_QUE_API
PUBLIC_REVERB_HOST=api.worldwise-admission.com
PUBLIC_REVERB_PORT=443
PUBLIC_REVERB_SCHEME=https
